{
  // Ondu Karaoke — one Cloudflare Worker serves the whole app:
  //   /            → the React app (Static Assets)
  //   /api/*       → song search, health, room creation
  //   /ws?room=…   → the real-time socket (a Durable Object per room)
  //
  //   npx wrangler dev       → run it locally
  //   npx wrangler deploy    → ship it
  //
  // The YouTube key is a secret:  npx wrangler secret put YOUTUBE_API_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ondu-karaoke",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React build is uploaded as static assets and served with an SPA
  // fallback, so /host and /join/:code work on a hard refresh.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },

  // One Durable Object per room (4-letter code).
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
