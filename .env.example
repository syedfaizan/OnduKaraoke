# ---------------------------------------------------------------------------
# Ondu Karaoke — backend environment
# Copy this file to `.env` in the project root and fill in the values.
# The .env file is ONLY read by the backend; the YouTube key never reaches
# a phone or the browser.
# ---------------------------------------------------------------------------

# YouTube Data API v3 key. Required for song search.
# Create one at: https://console.cloud.google.com/apis/credentials
#   → "Create credentials" → "API key"
#   → then enable the "YouTube Data API v3" for that key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Memes come from GIPHY when VITE_GIPHY_API_KEY is set in client/.env.
# See client/.env.example — GIPHY requires the search call to be made by the
# browser, so this is a domain-restricted *public* key, not a server secret.

# Port for the backend. In production the built frontend is served from the
# same port (so phones only need one URL).
# Render / Railway / Fly inject their own PORT — leave this as is locally.
PORT=3001

# ---------------------------------------------------------------------------
# CORS — who may call this API from a browser?
#
# Leave unset (or "*") when the backend also serves the frontend.
# When the frontend is hosted separately (e.g. on Vercel), set the frontend
# origin here, comma separated for several:
#
#   CLIENT_ORIGIN=https://ondu-karaoke.vercel.app
#
# ---------------------------------------------------------------------------
# CLIENT_ORIGIN=*
